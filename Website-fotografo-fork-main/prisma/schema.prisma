generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  COLABORADOR
  ANOTADOR
  CURADOR
  ADMINISTRADOR
}

enum StatusAnotacao {
  PENDENTE
  ANOTADO
  PULADO
}

enum StatusRevisao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusAnotacaoBloqueio {
  LIVRE
  BLOQUEADO
}

enum OrigemImagem {
  COLABORATIVO
  IA_GENERATIVA
}

model Usuario {
  id                Int               @id @default(autoincrement())
  nome              String
  email             String            @unique
  senha             String
  status_conta      Boolean           @default(true)
  papel             PapelUsuario      @default(COLABORADOR)
  ultimo_acesso     DateTime?
  registros         RegistroIconografico[]
  registros_curados RegistroIconografico[] @relation("CuradoriaRegistros")
  anotacoes         RegistroIconografico[] @relation("Anotacoes")
  review_notes      ReviewNote[]           @relation("ReviewerNotes")
  termos_aceitos    UsuarioTermo[]
  politicas_aceitas UsuarioPolitica[]
}

model TermoDeUso {
  id                 Int          @id @default(autoincrement())
  versao             String
  conteudo           String       @db.Text
  data_vigencia      DateTime     @default(now())
  usuarios_aceitaram UsuarioTermo[]
}

model PoliticaDePrivacidade {
  id                 Int               @id @default(autoincrement())
  versao             String
  conteudo           String            @db.Text
  data_vigencia      DateTime          @default(now())
  usuarios_aceitaram UsuarioPolitica[]
}

model UsuarioTermo {
  id          Int        @id @default(autoincrement())
  data_aceite DateTime   @default(now())
  usuarioId   Int
  termoId     Int
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  termo       TermoDeUso @relation(fields: [termoId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, termoId])
}

model UsuarioPolitica {
  id          Int                   @id @default(autoincrement())
  data_aceite DateTime              @default(now())
  usuarioId   Int
  politicaId  Int
  usuario     Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  politica    PoliticaDePrivacidade @relation(fields: [politicaId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, politicaId])
}

model DominioCultural {
  id        Int                    @id @default(autoincrement())
  nome_categoria String            @unique
  registros RegistroIconografico[]
}

model RegistroIconografico {
  id                     Int                   @id @default(autoincrement())
  url                    String
  hash_sha256            String                @unique
  titulo                 String
  descricao              String?               @db.Text
  municipio              String?
  data_upload            DateTime              @default(now())
  data_captura           DateTime?
  largura_pixels         Int?
  altura_pixels          Int?
  tamanho_bytes          Int?
  formato_arquivo        String?
  modelo_camera          String?
  latitude               Float?
  longitude              Float?
  exif_camera            Boolean               @default(false)
  licenca                String
  categoria_sugerida     String?
  status_curadoria       String                @default("PENDENTE")
  status_anotacao        StatusAnotacao        @default(PENDENTE)
  status_revisao         StatusRevisao         @default(PENDENTE)
  status_bloqueio        StatusAnotacaoBloqueio @default(LIVRE)
  justificativa_pulo     String?               @db.Text
  origem                 OrigemImagem          @default(COLABORATIVO)
  modelo_ia              String?
  prompt_ia              String?               @db.Text
  detalhes_ia            String?               @db.Text
  usuarioId              Int
  usuario                Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  dominioId              Int
  dominio                DominioCultural       @relation(fields: [dominioId], references: [id], onDelete: Restrict)
  curadorId              Int?
  curador                Usuario?              @relation("CuradoriaRegistros", fields: [curadorId], references: [id], onDelete: SetNull)
  anotadorId             Int?
  anotador               Usuario?              @relation("Anotacoes", fields: [anotadorId], references: [id], onDelete: SetNull)
  labels                 RegistroLabel[]
  review_notes           ReviewNote[]
  bounding_boxes Json?
}

model ReviewNote {
  id          Int      @id @default(autoincrement())
  registroId  Int
  registro    RegistroIconografico @relation(fields: [registroId], references: [id], onDelete: Cascade)
  reviewerId  Int
  reviewer    Usuario  @relation("ReviewerNotes", fields: [reviewerId], references: [id])
  note        String   @db.Text
  created_at  DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([registroId])
  @@index([reviewerId])
  @@index([resolved])
}

model Label {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  registros RegistroLabel[]
}

model RegistroLabel {
  registroId Int
  labelId    Int
  registro   RegistroIconografico @relation(fields: [registroId], references: [id], onDelete: Cascade)
  label      Label                @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([registroId, labelId])
}